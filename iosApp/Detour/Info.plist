<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Supplying our own INFOPLIST_FILE means XcodeGen does not generate the
         bundle keys, and without CFBundleIdentifier the simulator refuses the
         app outright ("Missing bundle ID"). -->
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Detour</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>UILaunchScreen</key>
    <dict/>

    <!-- The map and a running trip both need location while the app is open. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Detour uses your location to spin for a destination near you and to draw the map around you.</string>
    <!-- Trip recording continues with the screen off, which is the whole point
         of it on a bike. iOS shows this string when the user is asked to
         upgrade from When In Use. -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Detour records your ride in the background so a trip keeps logging with the screen off and your fog of war fills in as you go.</string>
    <key>NSMotionUsageDescription</key>
    <string>Detour uses motion data to tell a drive from a walk and to measure lean angle on a bike.</string>
    <!-- Convoy push-to-talk. The microphone is only ever opened while the mic
         button is held, but PttAudio activates a .playAndRecord session to do
         it, and iOS refuses that session — and terminates the app for
         attempting it — with no usage description declared. The `audio`
         background mode below has named this feature since it shipped; this
         key is the half that was missing. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Detour uses the microphone for convoy push-to-talk, so you can talk to the riders you are with without taking your gloves off.</string>

    <key>UIBackgroundModes</key>
    <array>
        <!-- Trip tracking. The iOS counterpart of Android's location
             foreground service: without it every fix stops at lock. -->
        <string>location</string>
        <!-- Convoy push-to-talk capture and spoken turn instructions. -->
        <string>audio</string>
    </array>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- This scheme carries two things back into the app. The realm's
         authorization-code callback after a sign-in (`detour://auth/callback`,
         registered with the realm as this client's redirect_uri — see
         `Oidc.isCallback` and `SignIn.swift`, and the matching comment on
         Android's own intent filter in AndroidManifest.xml). And legacy
         password-reset links from the sync server's mails
         (`detour://reset?token=…`) — the realm owns password reset now, so
         Android no longer registers a filter for this half, but iOS still
         parks the token (see `PendingReset`'s doc). That half is a custom
         scheme rather than https on purpose: the sync server sits behind
         Cloudflare Access, so a browser following an https link would meet
         the Access wall, while the app already holds the service token. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>io.github.maxke24.detour.urlscheme</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>detour</string>
            </array>
        </dict>
    </array>

    <!-- Server endpoints, filled from Config.xcconfig at build time. These are
         the iOS half of what BuildConfig does on Android; empty is a valid
         value and means "no baked default", exactly as in a CI build with no
         secrets set. -->
    <key>DetourRoutingURL</key>
    <string>$(DETOUR_ROUTING_URL)</string>
    <key>DetourApiURL</key>
    <string>$(DETOUR_API_URL)</string>
    <key>DetourIdpIssuer</key>
    <string>$(DETOUR_IDP_ISSUER)</string>
    <key>DetourGeocoderURL</key>
    <string>$(DETOUR_GEOCODER_URL)</string>
    <key>DetourLiveURL</key>
    <string>$(DETOUR_LIVE_URL)</string>
</dict>
</plist>
