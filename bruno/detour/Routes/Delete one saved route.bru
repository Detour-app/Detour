meta {
  name: Delete one saved route
  type: http
  seq: 2
}

delete {
  url: {{BASE_URL}}/api/routes/:clientId
  body: none
  auth: inherit
}

params:path {
  clientId: {{clientId}}
}

assert {
  res.status: eq 204
}

docs {
  Removes the stored copy and keeps the deletion, so a phone that still holds the route drops it on its next sync instead of uploading it again. Idempotent: deleting a route that is already gone, or never existed, answers 204 too.

  Responses:
  - 204: No Content
  - 400: Bad Request
}
