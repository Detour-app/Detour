meta {
  name: Delete a feature flag and its overrides
  type: http
  seq: 5
}

delete {
  url: {{BASE_URL}}/api/admin/flags/:key
  body: none
  auth: inherit
}

params:path {
  key: {{key}}
}

assert {
  res.status: eq 204
}

docs {
  The app then keeps its compiled default for the key, as it does for a key this server never had.

  Responses:
  - 204: No Content
  - 400: Bad Request
  - 403: Forbidden
  - 404: Not Found
}
