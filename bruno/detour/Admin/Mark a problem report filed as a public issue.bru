meta {
  name: Mark a problem report filed as a public issue
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/api/admin/problem-reports/:id/filed
  body: json
  auth: inherit
}

params:path {
  id: {{id}}
}

body:json {
  {
    "issue": "https://github.com/Detour-app/Detour/issues/1"
  }
}

assert {
  res.status: eq 204
}

docs {
  issue is the https URL of the issue. Marking it again is a no-op that keeps the first issue, so a retried call is safe.

  Responses:
  - 204: No Content
  - 400: Bad Request
  - 403: Forbidden
  - 404: Not Found
}
