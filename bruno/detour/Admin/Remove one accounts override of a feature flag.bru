meta {
  name: Remove one account's override of a feature flag
  type: http
  seq: 7
}

delete {
  url: {{BASE_URL}}/api/admin/flags/:key/accounts/:accountId
  body: none
  auth: inherit
}

params:path {
  key: {{key}}
  accountId: {{accountId}}
}

assert {
  res.status: eq 204
}

docs {
  The account gets the default again on its next GET /api/flags.

  Responses:
  - 204: No Content
  - 400: Bad Request
  - 403: Forbidden
  - 404: Not Found
}
