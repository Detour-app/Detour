meta {
  name: Set a feature flag default
  type: http
  seq: 6
}

put {
  url: {{BASE_URL}}/api/admin/flags/:key
  body: json
  auth: inherit
}

params:path {
  key: {{key}}
}

body:json {
  {
    "enabled": false
  }
}

assert {
  res.status: eq 204
}

docs {
  Creates the flag when this server has no row for it yet. Every account without an override gets the new value on its next GET /api/flags.

  Responses:
  - 204: No Content
  - 400: Bad Request
  - 403: Forbidden
}
