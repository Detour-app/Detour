meta {
  name: Set a feature flag for one account
  type: http
  seq: 8
}

put {
  url: {{BASE_URL}}/api/admin/flags/:key/accounts/:accountId
  body: json
  auth: inherit
}

params:path {
  key: {{key}}
  accountId: {{accountId}}
}

body:json {
  {
    "enabled": false
  }
}

assert {
  res.status: eq 204
}

docs {
  Replaces the default for that account only. The flag must exist first: set its default before overriding it.

  Responses:
  - 204: No Content
  - 400: Bad Request
  - 403: Forbidden
  - 404: No such flag, or no such account.
}
