<?xml version="1.0" encoding="utf-8"?>
<!-- Red-light (and combined) camera marker: same shell as ic_map_camera - the
     round European enforcement sign with a front-on camera - but the ring is
     blue rather than sign-red, and the flash window is replaced by a small
     stacked red/amber/green traffic-light glyph, so the two are tellable apart
     at a glance before CameraWarner has to say why (maxke24/Detour#317).
     Same 48-unit grid at 36dp; see ic_map_camera.xml's own note on the 2x
     rasterisation this and CAMERA_ICON_SCALE share. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- drop shadow -->
    <path
        android:fillColor="#33000000"
        android:pathData="M24,26m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- enforcement ring, blue rather than the speed camera's sign-red -->
    <path
        android:fillColor="#FF2B57D8"
        android:pathData="M24,24m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- white face -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,24m-15.5,0a15.5,15.5 0 1,1 31,0a15.5,15.5 0 1,1 -31,0" />
    <!-- mounting bracket -->
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M22,31h4v3h-4z M19,34h10a1.4,1.4 0 0,1 1.4,1.4v0.6h-12.8v-0.6a1.4,1.4 0 0,1 1.4,-1.4z" />
    <!-- camera body -->
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M15.2,16.5h19.6a2.2,2.2 0 0,1 2.2,2.2v10.6a2.2,2.2 0 0,1 -2.2,2.2h-19.6a2.2,2.2 0 0,1 -2.2,-2.2v-10.6a2.2,2.2 0 0,1 2.2,-2.2z" />
    <!-- viewfinder hump -->
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M21.5,12.5h6a1.5,1.5 0 0,1 1.5,1.5v2.5h-9v-2.5a1.5,1.5 0 0,1 1.5,-1.5z" />
    <!-- traffic-light glyph, stands where the flash window sits on the speed
         camera icon -->
    <path
        android:fillColor="#FFD8382B"
        android:pathData="M16.5,18.3m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" />
    <path
        android:fillColor="#FFF2A007"
        android:pathData="M16.5,20.9m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" />
    <path
        android:fillColor="#FF2E9E4E"
        android:pathData="M16.5,23.5m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" />
    <!-- lens: white bezel, dark barrel, red pupil, white glint -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M25,24m-6.2,0a6.2,6.2 0 1,1 12.4,0a6.2,6.2 0 1,1 -12.4,0" />
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M25,24m-4.7,0a4.7,4.7 0 1,1 9.4,0a4.7,4.7 0 1,1 -9.4,0" />
    <path
        android:fillColor="#FFD8382B"
        android:pathData="M25,24m-2.3,0a2.3,2.3 0 1,1 4.6,0a2.3,2.3 0 1,1 -4.6,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M23.2,22.2m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" />
</vector>
