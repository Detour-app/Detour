<?xml version="1.0" encoding="utf-8"?>
<!-- Speed-camera marker: the round European enforcement sign - white face,
     sign-red ring - with a front-on camera (body, viewfinder hump, mounting
     bracket, multi-ring lens) sitting wholly inside the white face. Authored
     on a 48-unit grid at 36dp so MapOverlays can rasterise it at 2x for a
     crisp bitmap; see the iconSize(0.5) on the "mr-cameras" layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- drop shadow -->
    <path
        android:fillColor="#33000000"
        android:pathData="M24,26m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- sign-red ring -->
    <path
        android:fillColor="#FFD8382B"
        android:pathData="M24,24m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- white face -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,24m-15.5,0a15.5,15.5 0 1,1 31,0a15.5,15.5 0 1,1 -31,0" />
    <!-- mounting bracket -->
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M22,31h4v3h-4z M19,34h10a1.4,1.4 0 0,1 1.4,1.4v0.6h-12.8v-0.6a1.4,1.4 0 0,1 1.4,-1.4z" />
    <!-- camera body -->
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M15.2,16.5h19.6a2.2,2.2 0 0,1 2.2,2.2v10.6a2.2,2.2 0 0,1 -2.2,2.2h-19.6a2.2,2.2 0 0,1 -2.2,-2.2v-10.6a2.2,2.2 0 0,1 2.2,-2.2z" />
    <!-- viewfinder hump -->
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M21.5,12.5h6a1.5,1.5 0 0,1 1.5,1.5v2.5h-9v-2.5a1.5,1.5 0 0,1 1.5,-1.5z" />
    <!-- flash window -->
    <path
        android:fillColor="#FFF2A007"
        android:pathData="M15.5,19h3.6v2.8h-3.6z" />
    <!-- lens: white bezel, dark barrel, red pupil, white glint -->
