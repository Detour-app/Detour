<?xml version="1.0" encoding="utf-8"?>
<!-- Spot speed-camera marker (#404): a sign-red disc in a white ring with a
     plain white camera silhouette, the lens punched through in the disc's red.
     One of a set of three - see ic_map_camera_section and
     ic_map_camera_redlight - that differ in colour *and* shape, so they can be
     told apart at marker size without reading detail. Authored on a 48-unit
     grid at 36dp so MapOverlays can rasterise it at 2x (CAMERA_ICON_SCALE). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- drop shadow -->
    <path
        android:fillColor="#33000000"
        android:pathData="M24,26m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- white ring, so the disc reads on the dark basemap too -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,24m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- sign-red disc -->
    <path
        android:fillColor="#FFD8382B"
        android:pathData="M24,24m-17.5,0a17.5,17.5 0 1,1 35,0a17.5,17.5 0 1,1 -35,0" />
    <!-- camera silhouette: viewfinder hump and body -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M21,14.5h6a1,1 0 0,1 1,1v2.5h-8v-2.5a1,1 0 0,1 1,-1z M16,18h16a2,2 0 0,1 2,2v10a2,2 0 0,1 -2,2h-16a2,2 0 0,1 -2,-2v-10a2,2 0 0,1 2,-2z" />
    <!-- lens -->
    <path
        android:fillColor="#FFD8382B"
        android:pathData="M24,25m-4.5,0a4.5,4.5 0 1,1 9,0a4.5,4.5 0 1,1 -9,0" />
</vector>
