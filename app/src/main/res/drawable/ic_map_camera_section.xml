<?xml version="1.0" encoding="utf-8"?>
<!-- Average-speed section camera marker (#404), drawn at a section's entry and
     exit devices. Same shell and camera as ic_map_camera - round sign, front-on
     camera, multi-ring lens, on the same 48-unit grid at 36dp - but the whole
     sign is purple, the camera is white, and a two-headed arrow ("measured over
     a distance") stands where the mounting bracket was. Purple rather than blue:
     ic_map_camera_redlight already has a blue ring, and a blue section sign read
     as the same icon at marker size. See ic_map_camera.xml for the 2x
     rasterisation. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- drop shadow -->
    <path
        android:fillColor="#33000000"
        android:pathData="M24,26m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- purple sign: ring and face in one colour -->
    <path
        android:fillColor="#FF8E44D0"
        android:pathData="M24,24m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- camera body -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15.2,16.5h19.6a2.2,2.2 0 0,1 2.2,2.2v10.6a2.2,2.2 0 0,1 -2.2,2.2h-19.6a2.2,2.2 0 0,1 -2.2,-2.2v-10.6a2.2,2.2 0 0,1 2.2,-2.2z" />
    <!-- viewfinder hump -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M21.5,12.5h6a1.5,1.5 0 0,1 1.5,1.5v2.5h-9v-2.5a1.5,1.5 0 0,1 1.5,-1.5z" />
    <!-- flash window -->
    <path
        android:fillColor="#FFF2A007"
        android:pathData="M15.5,19h3.6v2.8h-3.6z" />
    <!-- lens: purple bezel, dark barrel, red pupil, white glint -->
    <path
        android:fillColor="#FF8E44D0"
        android:pathData="M25,24m-6.2,0a6.2,6.2 0 1,1 12.4,0a6.2,6.2 0 1,1 -12.4,0" />
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M25,24m-4.7,0a4.7,4.7 0 1,1 9.4,0a4.7,4.7 0 1,1 -9.4,0" />
    <path
        android:fillColor="#FFD8382B"
        android:pathData="M25,24m-2.3,0a2.3,2.3 0 1,1 4.6,0a2.3,2.3 0 1,1 -4.6,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M23.2,22.2m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" />
    <!-- two-headed arrow: the distance the average is taken over -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15.5,35.5l3.6,-3v1.8h9.8v-1.8l3.6,3l-3.6,3v-1.8h-9.8v1.8z" />
</vector>
