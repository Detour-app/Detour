<?xml version="1.0" encoding="utf-8"?>
<!-- Average-speed section camera marker (#404), drawn at a section's entry and
     exit devices. Same shell as ic_map_camera - the round enforcement sign with
     a white face - but the ring is purple, and the glyph is a pair: two small
     front-on cameras on one bar and stand, for the start and end of the
     measured stretch. Spot is one camera, red-light is a camera with a traffic
     light, section is two. Purple rather than blue: ic_map_camera_redlight
     already has a blue ring. Same 48-unit grid at 36dp; see ic_map_camera.xml
     for the 2x rasterisation. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- drop shadow -->
    <path
        android:fillColor="#33000000"
        android:pathData="M24,26m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- enforcement ring, purple: red is the spot camera, blue the red-light -->
    <path
        android:fillColor="#FF8E44D0"
        android:pathData="M24,24m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0" />
    <!-- white face -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,24m-15.5,0a15.5,15.5 0 1,1 31,0a15.5,15.5 0 1,1 -31,0" />
    <!-- stand: the bar both cameras sit on, the post, and the same foot as
         ic_map_camera's mounting bracket -->
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M15,26.5h18a1,1 0 0,1 1,1v0a1,1 0 0,1 -1,1h-18a1,1 0 0,1 -1,-1v0a1,1 0 0,1 1,-1z M16,24h2v3h-2z M30,24h2v3h-2z M22,28h4v6h-4z M19,34h10a1.4,1.4 0 0,1 1.4,1.4v0.6h-12.8v-0.6a1.4,1.4 0 0,1 1.4,-1.4z" />
    <!-- left camera: body and viewfinder hump -->
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M13,16h9a1.5,1.5 0 0,1 1.5,1.5v6a1.5,1.5 0 0,1 -1.5,1.5h-9a1.5,1.5 0 0,1 -1.5,-1.5v-6a1.5,1.5 0 0,1 1.5,-1.5z M15.5,13.5h4a1,1 0 0,1 1,1v1.5h-6v-1.5a1,1 0 0,1 1,-1z" />
    <!-- right camera: body and viewfinder hump -->
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M26,16h9a1.5,1.5 0 0,1 1.5,1.5v6a1.5,1.5 0 0,1 -1.5,1.5h-9a1.5,1.5 0 0,1 -1.5,-1.5v-6a1.5,1.5 0 0,1 1.5,-1.5z M28.5,13.5h4a1,1 0 0,1 1,1v1.5h-6v-1.5a1,1 0 0,1 1,-1z" />
    <!-- lenses: white bezel, dark barrel, red pupil, as on ic_map_camera -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.5,20.5m-3.3,0a3.3,3.3 0 1,1 6.6,0a3.3,3.3 0 1,1 -6.6,0 M30.5,20.5m-3.3,0a3.3,3.3 0 1,1 6.6,0a3.3,3.3 0 1,1 -6.6,0" />
    <path
        android:fillColor="#FF1B2430"
        android:pathData="M17.5,20.5m-2.4,0a2.4,2.4 0 1,1 4.8,0a2.4,2.4 0 1,1 -4.8,0 M30.5,20.5m-2.4,0a2.4,2.4 0 1,1 4.8,0a2.4,2.4 0 1,1 -4.8,0" />
    <path
        android:fillColor="#FFD8382B"
        android:pathData="M17.5,20.5m-1.2,0a1.2,1.2 0 1,1 2.4,0a1.2,1.2 0 1,1 -2.4,0 M30.5,20.5m-1.2,0a1.2,1.2 0 1,1 2.4,0a1.2,1.2 0 1,1 -2.4,0" />
</vector>
