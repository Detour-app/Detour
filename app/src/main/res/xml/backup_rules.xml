<?xml version="1.0" encoding="utf-8"?>
<!-- Google Drive auto-backup (Android 11 and below). Trips and fog-of-war
     traces survive uninstall/reinstall.

     settings.xml (auth_token) and routing_server.xml (CF Access client
     secret) are deliberately NOT included here: this file only ever backs up
     to the cloud (there is no on-device-transfer variant pre-12), and a
     bearer token or CF secret in a Google Drive backup outlives the user
     revoking it. The config-file export (Settings -> Server config file) is
     the supported way to carry those credentials to a new install. -->
<full-backup-content>
    <include domain="file" path="trips.json" />
    <include domain="file" path="traces.jsonl" />
</full-backup-content>
