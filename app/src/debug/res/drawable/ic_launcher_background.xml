<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only override of the adaptive icon's background layer. Identical
     geometry and gradient direction to app/src/main/res/drawable/, with the
     graphite field swapped for the app's amber accent — the foreground and
     monochrome layers are untouched, so the mark still reads as Detour rather
     than as a different app.

     The label alone does not solve this: launcher grids truncate to roughly ten
     characters, so "Detour" and "Detour (debug)" both render as "Detour…".
     Colour is what tells them apart at a glance. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="37.8" android:endY="108">
                <item android:offset="0" android:color="#6B4A0F" />
                <item android:offset="1" android:color="#241703" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
