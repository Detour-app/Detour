# region = Geofabrik .pbf URL. Mounted into the osm-extract init container.
# A new region is a one-line PR — no image rebuild.
#
# Approx first-boot cost (GraphHopper 11, graph + CH for car and moto):
#   benelux   ~10 GB heap   ~25 min
#   france    ~18 GB heap   ~50 min
#   germany   ~22 GB heap   ~65 min
# france and germany need a build machine with that much RAM until the prebuilt
# graphs land (sub-project 2). benelux runs on a modest box.
benelux=https://download.geofabrik.de/europe/benelux-latest.osm.pbf
france=https://download.geofabrik.de/europe/france-latest.osm.pbf
germany=https://download.geofabrik.de/europe/germany-latest.osm.pbf
