# Path-routes one hostname to the three services a rider can otherwise only
# reach as three separate addresses (Settings → Server → "Different address
# per service"). See docs/DEVELOPERS.md § "Baking addresses into a build".
#
# The API and Photon both answer under /api — that's the whole reason a
# split deployment exists at all (docs/DEVELOPERS.md says so explicitly). What
# makes one hostname possible here is that Photon search answers *only* the
# exact path `/api/` (query params carry the search), while every API route is
# `/api/<something>`. nginx's `=` (exact) location always wins over a prefix
# one regardless of file order, so the two can't collide. Photon's reverse
# lookup is `/reverse`, outside /api altogether.
#
# GraphHopper and Photon are in this compose project on the shared networks
# (docker-compose.routing.yml / docker-compose.search.yml), so they're
# addressed by service name — `graphhopper:8989` and `photon:2322` — the same
# way `api:7500` is. No copied-in IP to keep in sync. For a deployment where
# GraphHopper or Photon runs outside this project (another LAN host), the
# GRAPHHOPPER_UPSTREAM / PHOTON_UPSTREAM env-var forms are kept below as
# commented alternatives (envsubst blanks the ${...} inside those comments
# when the var is unset — set the var and uncomment and it renders).
#
# A .template: the official nginx image's entrypoint runs envsubst over
# every file here and writes the result to /etc/nginx/conf.d before nginx
# starts (see docker-compose.proxy.yml). envsubst only touches names that
# are actually set as container env vars — $host, $remote_addr, $scheme and
# $http_x_forwarded_proto below are nginx's own request variables, never
# exported, so they pass through untouched; PHOTON_UPSTREAM /
# GRAPHHOPPER_UPSTREAM matter only if you uncomment the commented proxy_pass
# lines below and set the vars in .env.

# The scheme the rider actually used. cloudflared terminates TLS and reaches
# this container over plain http, so $scheme alone is always `http`; keep the
# hop in front's X-Forwarded-Proto when it sent one.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Per-rider rate limits on the two engines nginx exposes without auth. The API
# throttles itself (UseRateLimiter); GraphHopper and Photon don't, so without
# these anyone who learns the hostname has a free routing and geocoding
# service, and /route is CPU-heavy. Keyed on the rider's address, which
# set_real_ip_from below rewrites before these zones read it.
#
# Sized so a rider never sees them: a spin fires a handful of /route calls at
# once (three rolls in parallel), search fires at most one Photon query per
# 300 ms debounce. The burst absorbs the spin; the rate caps a scraper.
# 10m of shared memory holds ~160k addresses.
limit_req_zone $binary_remote_addr zone=route_per_ip:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=search_per_ip:10m rate=5r/s;

server {
    # default_server: the image ships its own default.conf, also on port 80,
    # and it sorts first. Without this every request whose Host isn't
    # `localhost` — every rider on the public hostname — lands there and 404s.
    listen 80 default_server;
    server_name _;

    # The rider's address, not the hop in front of this one. cloudflared (or
    # whatever terminates the public hostname) connects from another host, so
    # without this $remote_addr is that host for every request — and the API,
    # which trusts exactly one hop (ForwardLimit 1, backend/INSTALL.md), would
    # rate-limit all riders as one. PROXY_REAL_IP_FROM names that host (address
    # or CIDR, docker/prod/.env); only its X-Forwarded-For is believed, so a LAN
    # client can't pick its own bucket. Unset, it is loopback: nothing is
    # trusted and $remote_addr stays the connecting peer.
    set_real_ip_from ${PROXY_REAL_IP_FROM};
    real_ip_header X-Forwarded-For;

    # 429, not nginx's default 503: a throttled rider is not an outage, and
    # anything watching the logs for 5xx shouldn't page on one.
    limit_req_status 429;

    # Photon: exact "/api/" only (its query-string search endpoint).
    location = /api/ {
        limit_req zone=search_per_ip burst=20 nodelay;
        proxy_pass http://photon:2322/api/;
        # Off-box Photon: comment the line above, uncomment the next, and set
        # PHOTON_UPSTREAM in docker/prod/.env (e.g. http://192.168.x.x:2322).
        # proxy_pass ${PHOTON_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Photon's reverse lookup, which names spin picks and tapped route stops.
    # Outside /api, so it collides with nothing. Without it the app falls back
    # to showing coordinates.
    location = /reverse {
        proxy_pass http://photon:2322/reverse;
        # Off-box Photon: same swap as above.
        # proxy_pass ${PHOTON_UPSTREAM}/reverse;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # The sync + social API: everything else under /api, including the
    # convoy live relay's WebSocket upgrade (Startup.cs enables it ahead of
    # auth, but the route itself is still one of this prefix's controllers).
    # Addressed by compose service name — the API is in this project and on
    # the shared `edge` network, so it never needs a copied-in IP.
    location /api/ {
        proxy_pass http://api:7500/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
    }

    # GraphHopper. RoutingClient only ever calls /route (GET and POST) — no
    # /isochrone, /nearest or /health from the app, so nothing else is routed.
    location /route {
        limit_req zone=route_per_ip burst=20 nodelay;
        proxy_pass http://graphhopper:8989/route;
        # Off-box GraphHopper: comment the line above, uncomment the next, and
        # set GRAPHHOPPER_UPSTREAM in docker/prod/.env (e.g. http://192.168.x.x:8989).
        # proxy_pass ${GRAPHHOPPER_UPSTREAM}/route;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
