# Copy to docker/prod/.env and fill in. Unlike docker/dev/.env.example, nothing
# here has a working default: compose refuses to start without the secrets, which
# is the point. A stack that boots with a password published in this repository is
# worse than one that will not boot.
#
# Generate each secret rather than inventing one:
#
#   openssl rand -base64 32

PROJECT_NAME=detour
TZ=Europe/Brussels

# --- The image ---------------------------------------------------------------
# Published by .github/workflows/backend.yml. `latest` follows main; pin the tag
# to a commit sha for a deployment you can roll back to a known build.
DETOUR_IMAGE=ghcr.io/jonohas/detour-api
DETOUR_IMAGE_TAG=latest

# Bound to 127.0.0.1 by the compose file. Your reverse proxy talks to these.
API_PORT=7500
KC_PORT=7580

# --- The backend's database --------------------------------------------------
# The API applies its own migrations at startup, so this role must be able to
# create tables in this database.
POSTGRES_USER=detour
POSTGRES_DB=detour
POSTGRES_PASSWORD=

# --- Identity ----------------------------------------------------------------
# The public URL Keycloak serves on. Must be the scheme and host your clients
# actually reach, because it is baked into every token and redirect URI.
KC_HOSTNAME=https://idp.example.com

# The exact `iss` claim the API requires. This is KC_HOSTNAME plus the realm path,
# and it is compared exactly rather than as a prefix.
IDP_ISSUER=https://idp.example.com/realms/detour

IDP_AUDIENCE=detour-api
IDP_ADMIN_ROLE=detour-admin

# Only turn this off for a stack on plain HTTP, which production should not be.
IDP_REQUIRE_HTTPS=true

# Bootstrap administrator, used once to create the realm. Keycloak ignores these
# after an admin exists — create a real one and clear these from .env.
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=

KC_DB_USER=keycloak
KC_DB_NAME=keycloak
KC_DB_PASSWORD=
KC_LOG_LEVEL=info

# --- Behind a reverse proxy --------------------------------------------------
# Set one of these or the API ignores X-Forwarded-* entirely and every request
# looks like it came from the proxy — including to the rate limiter, which then
# throttles all your riders as though they were one.
#
# The Docker bridge network, usually:
FORWARDED_KNOWN_NETWORKS=172.16.0.0/12
FORWARDED_KNOWN_PROXIES=

# --- Cloudflare Tunnel (docker-compose.cloudflare.yml) -----------------------
# Only needed with that overlay. Zero Trust -> Networks -> Tunnels gives you the
# token. See CLOUDFLARE.md — the short version is that the API may sit behind an
# Access service token and Keycloak may not.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional cache (--profile cache) ----------------------------------------
# Only worth it with more than one API container. Leave REDIS_CONNECTION empty
# otherwise: memory-only is a correct single-instance deployment.
REDIS_PASSWORD=
REDIS_CONNECTION=
