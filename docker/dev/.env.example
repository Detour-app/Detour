# Copy to docker/dev/.env and edit if a default clashes with something you run.
#
# Every value here has a working default in the compose files; this file exists
# to document what is tunable, not because anything must be set.

PROJECT_NAME=detour-dev
TZ=Europe/Brussels

# --- Postgres (the backend's own) -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=detour

# The least-privileged role the API actually connects as. Created by
# config/postgres/init/10-create-app-role.sh, which runs once on an empty volume.
DETOUR_DB_USER=detour
DETOUR_DB_PASSWORD=detour

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=detour-dev-redis

# --- Keycloak ----------------------------------------------------------------
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak
KC_DB_NAME=keycloak
KC_LOG_LEVEL=info

# Must match the issuer the API validates and the URI the app redirects to.
# Changing it invalidates every issued token and every stored redirect URI, and
# means wiping the keycloak-db volume so the realm re-imports.
KC_HOSTNAME=http://localhost:7580
